{
  "name": "stemcare-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "tsc && vite build",
    "build:server": "esbuild src/server/gemini.ts src/server/survey.ts --bundle --platform=node --format=esm --target=node20 --outdir=api",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^3.2.4"
  }
}
