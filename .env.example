# STEMCare Demo Environment Variables
# All optional — the demo is fully deterministic without any of these.

# Client flag: enables /api/gemini calls when "true". Safe to expose (no secret).
VITE_DEMO_LIVE_MODE="false"
# SERVER-SIDE ONLY — never prefix with VITE_. Held by the /api/gemini function.
GEMINI_API_KEY="your_server_side_gemini_key"
# Model override (default: gemini-3.1-flash-lite, matching production model policy)
DEMO_GEMINI_MODEL="gemini-3.1-flash-lite"
# Kill switch: set "true" to force every client to deterministic fallback instantly
DEMO_LIVE_KILL_SWITCH="false"

# Vercel Postgres Connection String (automatic when Vercel Postgres is provisioned)
# When set, demo evaluations are automatically saved to the demo_survey_responses table.
POSTGRES_URL=""

# Legacy: Google Sheets Webhook URL (Google Apps Script deployed under maadesiyan1@gmail.com)
# When set and POSTGRES_URL is omitted, demo evaluations are streamed to Google Sheets.
# When both are omitted, evaluations are securely stored in browser localStorage.
SURVEY_WEBHOOK_URL=""
